# Copy to deploy/oci/.env.web on the VM and fill in. The app's settings and secrets; never commit the copy.
# Names use __ for the : in settings (ConnectionStrings:TaxBuddy -> ConnectionStrings__TaxBuddy).

# The test site's Supabase database (session pooler, Npgsql keyword format; docs/SETUP.md).
ConnectionStrings__TaxBuddy=

# Google sign-in: the OAuth client's ID and secret. Add https://<SITE_ADDRESS>/signin-google to its redirect URIs.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Supabase Storage for pictures and service documents (buckets profile-pictures and service-documents).
Supabase__Url=
Supabase__SecretKey=

# Email (R08). Links point here: https://<SITE_ADDRESS>. Without the Brevo key and sender, no emails are sent.
Email__SiteAddress=
Email__Brevo__ApiKey=
Email__SenderAddress=
