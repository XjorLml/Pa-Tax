@* Connection notice for interactive pages (PRD R10; DESIGN connection states; prototype offlineBanner). A banner, not a
   modal, so typed text stays in reach while Blazor reconnects; nothing is sent meanwhile. *@
<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Styled in ReconnectModal.razor.css, not with .banner: that class sets display and would show the closed dialog. *@
<dialog id="components-reconnect-modal" data-nosnippet aria-live="polite">
    <Icon Name="wifiOff" Size="18" />
    <div>
        <p class="components-reconnect-first-attempt-visible">
            <strong>Connection lost.</strong> Reconnecting… Your typed text is kept.
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            <strong>Connection lost.</strong> Trying again in <span id="components-seconds-to-next-attempt"></span> seconds. Your typed text is kept.
        </p>
        <p class="components-reconnect-failed-visible">
            <strong>Couldn't reconnect.</strong> Your typed text is kept in this tab.
        </p>
        <p class="components-pause-visible">
            <strong>This page was paused.</strong> Your typed text is kept.
        </p>
        <p class="components-resume-failed-visible">
            <strong>Couldn't resume.</strong> Reload the page; your typed text is kept in this tab.
        </p>
    </div>
    <button id="components-reconnect-button" type="button" class="btn btn-sm components-reconnect-failed-visible">Try again</button>
    <button id="components-resume-button" type="button" class="btn btn-sm components-pause-visible components-resume-failed-visible">Resume</button>
</dialog>
