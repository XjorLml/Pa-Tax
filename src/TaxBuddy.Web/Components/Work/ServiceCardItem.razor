@using TaxBuddy.Web.Application.Work
@* F03: one service in a list (prototype workCard): name, status badge, checklist progress and its documents (R23). *@
<li class="work-service">
    <div class="work-row">
        <h3><a href="/work/@Card.Id">@Card.ServiceName</a></h3>
        <span class="work-status @(Card.Completed ? "done" : null)">@Card.StatusText</span>
    </div>
    <WorkMeter Done="Card.Done" Total="Card.Total" />
    <div class="work-row small">
        <span class="muted">@Card.Documents service document@(Card.Documents == 1 ? "" : "s")</span>
        <a href="/work/@Card.Id">Open service <Icon Name="chevron" Size="14" /></a>
    </div>
</li>

@code {
    [Parameter, EditorRequired] public ServiceCard Card { get; set; } = null!;
}
