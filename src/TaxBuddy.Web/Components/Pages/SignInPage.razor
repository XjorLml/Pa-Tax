@page "/signin"
@attribute [TermsNotRequired]
@using TaxBuddy.Web.Account
@inject AccountService Accounts
@inject DirectoryService Directory
@* F04 sign-in, laid out as the prototype's signinHTML (F02 BD10). Static: a plain form per provider, posted to the account
   endpoint. F15 (2026-11-23): Microsoft beside Google, shown only when the site has its keys and the switch is on; archived
   the same day by the owner, so it stays off. *@

<SeoHead Title="Sign in · Tax Buddy" Description="@($"Sign in to Tax Buddy with your {Providers} account.")" CanonicalPath="/signin" />
<PhoneBar Title="Sign in" Back="@returnUrl" />
<h1 class="sr-only" tabindex="-1">Sign in</h1>

@if (signedInAs is not null)
{
    <StateMessage IconName="check" Title="@($"You're signed in as {signedInAs}")">
        <a class="btn" href="/">Go to directory</a>
    </StateMessage>
}
else
{
    <div class="center-col">
        <BrandIcon Size="64" Class="mx-auto mb-2" />
        <h2>Welcome to Tax Buddy</h2>
        <p>@Lead</p>

        @if (Error == "failed")
        {
            <div class="banner danger inline" role="alert">
                <Icon Name="alert" Size="18" />
                <div>We couldn't sign you in with @Providers. Please try again.</div>
            </div>
        }

        @if (googleAvailable || microsoftAvailable)
        {
            <div class="stack">
                @if (googleAvailable)
                {
                    <form method="post" action="@AccountEndpoints.ExternalSignInPath">
                        <AntiforgeryToken />
                        <input type="hidden" name="provider" value="@AccountSetup.GoogleScheme" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-block">Continue with Google</button>
                    </form>
                }
                @if (microsoftAvailable)
                {
                    <form method="post" action="@AccountEndpoints.ExternalSignInPath">
                        <AntiforgeryToken />
                        <input type="hidden" name="provider" value="@AccountSetup.MicrosoftScheme" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-block">Continue with Microsoft</button>
                    </form>
                }
            </div>
        }
        else
        {
            <div class="banner warn" role="status">
                <Icon Name="lock" Size="18" />
                <div>Google sign-in isn't set up on this site yet.</div>
            </div>
        }

        <p class="muted small">Tax Buddy never sees your @Providers password.</p>
    </div>
}

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string returnUrl = "/";
    private string? signedInAs;
    private bool googleAvailable;
    private bool microsoftAvailable;

    /// <summary>"Google", "Microsoft" or "Google or Microsoft", for the lines that name them.</summary>
    private string Providers => microsoftAvailable && googleAvailable ? "Google or Microsoft" : microsoftAvailable ? "Microsoft" : "Google";

    /// <summary>The accountant's first name when the visitor came from writing to them (prototype signinHTML).</summary>
    private string? messageTo;

    /// <summary>The prototype's lead varies with where the visitor is going.</summary>
    private string Lead =>
        messageTo is { } name ? $"Sign in to send your message to {name}."
        : returnUrl.StartsWith("/chats/new/", StringComparison.Ordinal) ? "Sign in to send your message to this accountant."
        : returnUrl == "/account/profile" ? "Sign in to create your accountant profile. You'll choose “I'm an accountant” on the next step."
        : "Sign in to message accountants, or to publish your profile as an accountant.";

    protected override async Task OnInitializedAsync()
    {
        returnUrl = LocalAddress.OrHome(ReturnUrl);
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            signedInAs = HttpContext.User.FindFirst(TaxBuddyClaimsFactory.DisplayNameClaim)?.Value ?? "a Tax Buddy user";
            return;
        }

        googleAvailable = await Accounts.IsGoogleAvailableAsync();
        microsoftAvailable = await Accounts.IsMicrosoftAvailableAsync();
        if (returnUrl.StartsWith("/chats/new/", StringComparison.Ordinal))
        {
            try
            {
                // The draft itself stays in the tab's session storage, so the page can't quote it (DESIGN deviation).
                messageTo = await Directory.GetProfileAsync(returnUrl["/chats/new/".Length..]) is { } profile ? Display.FirstName(profile.Name) : null;
            }
            catch (DataUnavailableException)
            {
                // "this accountant" then.
            }
        }
    }
}
