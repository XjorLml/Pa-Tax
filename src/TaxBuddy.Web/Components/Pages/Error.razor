@page "/Error"
@using System.Diagnostics
@* PRD R18: an error page with a support code and a way back. Never shows exception details. *@

<PhoneBar Title="Something went wrong" Back="/" />
<SeoHead Title="Something went wrong · Tax Buddy" Description="An error occurred." CanonicalPath="/" />

@* The prototype's infoPage "error" case: a narrow panel titled "Something went wrong" holding the state. On phones the
   title is in the app bar. *@
<div class="narrow">
    <article class="panel prose info-state" aria-labelledby="page-title">
        <h1 id="page-title" tabindex="-1">Something went wrong</h1>
        <StateMessage IconName="alert" Title="Something went wrong on our side">
            <Description>
                Your work isn't lost. Try again in a moment.@if (!string.IsNullOrEmpty(RequestId))
                {
                    @(" If it keeps happening, contact us with this support code: ")<strong class="select-all">@RequestId</strong>@(".")
                }
            </Description>
            <ChildContent>
                <a class="btn btn-primary" href="/">Back to the directory</a>
            </ChildContent>
        </StateMessage>
    </article>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
