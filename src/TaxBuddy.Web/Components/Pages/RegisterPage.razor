@page "/register"
@using TaxBuddy.Web.Account
@using TaxBuddy.Web.Domain
@inject AccountService Accounts
@inject NavigationManager Navigation
@* F04 first sign-in (PRD R04, R16; D03: one role per account). A named form posted to this page (SDD render modes). *@

<SeoHead Title="Create your account · Tax Buddy" Description="Choose how you'll use Tax Buddy." CanonicalPath="/register" />

@if (pending is not null)
{
    <section class="mx-auto flex max-w-xl flex-col gap-4 rounded-xl border border-border bg-surface px-6 py-8" aria-labelledby="page-title">
        <h1 id="page-title" class="text-[28px]" tabindex="-1">How will you use Tax Buddy?</h1>
        <p class="text-muted">
            Signed in with @pending.ProviderName@(pending.Email is null ? "" : " as ")<strong class="text-text">@pending.Email</strong>.
            Choose one: an account is either a client or an accountant.
        </p>

        @if (failed)
        {
            <div class="notice notice-danger" role="alert">
                <Icon Name="alert" Size="18" />
                <p>We couldn't create your account. Please try again.</p>
            </div>
        }

        <form method="post" @formname="register" @onsubmit="RegisterAsync" class="flex flex-col gap-4" novalidate>
            <AntiforgeryToken />
            <input type="hidden" name="Form.ReturnUrl" value="@returnUrl" />

            <fieldset class="flex flex-col gap-3" aria-describedby="@(roleError is null ? null : "role-error")">
                <legend class="mb-1 font-semibold">I am…</legend>
                @foreach (var (value, title, description) in Choices)
                {
                    <label class="choice">
                        <input type="radio" name="Form.Role" value="@value" checked="@(Form!.Role == value)" />
                        <span><strong>@title</strong><span class="block text-[13.5px] text-muted">@description</span></span>
                    </label>
                }
                @if (roleError is not null)
                {
                    <p id="role-error" class="field-error">@roleError</p>
                }
            </fieldset>

            <div>
                <label class="flex items-start gap-3">
                    <input type="checkbox" name="Form.Agree" value="true" checked="@Form!.Agree" class="mt-1 size-5 shrink-0"
                           aria-describedby="@(agreeError is null ? null : "agree-error")" />
                    <span>I agree to the <a href="/terms">Terms of use</a> and the <a href="/privacy">Privacy policy</a>.</span>
                </label>
                @if (agreeError is not null)
                {
                    <p id="agree-error" class="field-error">@agreeError</p>
                }
            </div>

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="btn btn-primary">Create my account</button>
                <a class="btn" href="@AccountEndpoints.SignInPageAddress(returnUrl)">Start again</a>
            </div>
        </form>
    </section>
}

@code {
    private static readonly (string Value, string Title, string Description)[] Choices =
    [
        ("client", "I'm looking for an accountant", "Browse accountants, message them, and review the ones who help you."),
        ("accountant", "I'm an accountant", "Publish your profile and portfolio, and reply to client messages."),
    ];

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "register")] private RegisterForm? Form { get; set; }

    private PendingSignIn? pending;
    private string returnUrl = "/";
    private string? roleError;
    private string? agreeError;
    private bool failed;

    protected override async Task OnInitializedAsync()
    {
        Form ??= new RegisterForm { ReturnUrl = ReturnUrl };
        returnUrl = LocalAddress.OrHome(Form.ReturnUrl);

        // GS05: nothing to register without a sign-in in progress.
        pending = await Accounts.GetPendingAsync();
        if (pending is null)
        {
            Navigation.NavigateTo(AccountEndpoints.SignInPageAddress(returnUrl));
        }
    }

    private async Task RegisterAsync()
    {
        if (pending is null)
        {
            return;
        }

        var role = AccountRoles.Parse(Form!.Role);
        roleError = role is null ? "Choose whether you're looking for an accountant or you are one." : null;
        agreeError = Form.Agree ? null : "Tick the box to agree to the Terms of use and the Privacy policy.";
        if (role is null || !Form.Agree)
        {
            return;
        }

        switch (await Accounts.RegisterAsync(role.Value))
        {
            case RegistrationOutcome.SignedIn:
                Navigation.NavigateTo(returnUrl);
                break;
            case RegistrationOutcome.NoPendingSignIn:
                Navigation.NavigateTo(AccountEndpoints.SignInPageAddress(returnUrl));
                break;
            default:
                failed = true;
                break;
        }
    }

    private sealed class RegisterForm
    {
        public string? Role { get; set; }

        public bool Agree { get; set; }

        public string? ReturnUrl { get; set; }
    }
}
