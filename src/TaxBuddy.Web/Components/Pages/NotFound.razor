@page "/not-found"
@layout MainLayout
@using Microsoft.AspNetCore.Diagnostics
@* PRD R18: "Page not found" for unknown addresses, with a way back. For a profile address (R03, FT05) the
   message is "This profile is no longer available": a removed, unlisted or mistyped profile, not an error. *@

<PhoneBar Title="@(kind switch { Kind.Profile => "Profile", Kind.Chat or Kind.NewChat => "Chat", _ => "Page not found" })" Back="@(kind == Kind.Chat ? "/chats" : "/")" />

@if (kind == Kind.Chat)
{
    @* F07 CH07: someone else's conversation or an unknown one; nothing about it is shown. *@
    <SeoHead Title="Conversation not available · Tax Buddy" Description="This conversation isn't available." CanonicalPath="/chats" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="This conversation isn't available" Text="It may have been removed, or it belongs to a different account.">
        <a class="btn" href="/chats">Back to chats</a>
    </StateMessage>
}
else if (kind == Kind.NewChat)
{
    @* F07 CH08 (prototype threadParts): the accountant's profile is unlisted, removed or unknown. *@
    <SeoHead Title="Accountant not available · Tax Buddy" Description="This accountant is no longer available." CanonicalPath="/" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="This accountant is no longer available">
        <a class="btn" href="/">Back to directory</a>
    </StateMessage>
}
else if (kind == Kind.Profile)
{
    <SeoHead Title="Profile no longer available · Tax Buddy" Description="This accountant profile is no longer available." CanonicalPath="/" />
    <StateMessage IconName="list" HeadingLevel="1" Title="This profile is no longer available"
                  Text="It may have been removed, or the link may be wrong.">
        <a class="btn btn-primary" href="/">Back to the directory</a>
    </StateMessage>
}
else
{
    <SeoHead Title="Page not found · Tax Buddy" Description="This page does not exist." CanonicalPath="/" />
    <StateMessage IconName="search" HeadingLevel="1" Title="Page not found" Text="The address may be mistyped, or the page may have moved.">
        <a class="btn btn-primary" href="/">Go to the directory</a>
    </StateMessage>
}

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private enum Kind { Page, Profile, Chat, NewChat }

    private Kind kind;

    protected override void OnInitialized()
    {
        // Re-executed for a 404: the feature holds the address the visitor asked for. Rendered in place: the request path is it.
        var original = HttpContext?.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath ?? HttpContext?.Request.Path.Value;
        kind = original switch
        {
            { } path when path.StartsWith("/accountants/", StringComparison.OrdinalIgnoreCase) => Kind.Profile,
            { } path when path.StartsWith("/chats/new/", StringComparison.OrdinalIgnoreCase) => Kind.NewChat,
            { } path when path.StartsWith("/chats/", StringComparison.OrdinalIgnoreCase) => Kind.Chat,
            _ => Kind.Page,
        };
    }
}
