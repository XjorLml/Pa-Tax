@page "/not-found"
@attribute [TaxBuddy.Web.Account.TermsNotRequired]
@layout MainLayout
@using Microsoft.AspNetCore.Diagnostics
@using TaxBuddy.Web.Account
@using TaxBuddy.Web.Application.Work
@using TaxBuddy.Web.Components.Chat
@* PRD R18: "Page not found" for unknown addresses, with a way back. For a profile address (R03, FT05) the
   message is "This profile is no longer available": a removed, unlisted or mistyped profile, not an error.
   Since 2026-11-24 the other variants keep their prototype frames: workspace states sit under the workspace breadcrumb
   and h1, chat states in the detail pane beside the conversation list, and the review state in the "Write a review"
   panel. A visitor at a workspace or chat address is asked to sign in first, as on those pages. *@

<PhoneBar Title="@PhoneTitle" Back="@PhoneBack" />

@if (kind is Kind.Work or Kind.Request)
{
    @* F03 (BR15): someone else's service or client, or an unknown one; nothing about it is shown (prototype unavailable). *@
    <SeoHead Title="Not available · Tax Buddy" Description="This workspace isn't available." CanonicalPath="/workspace" />
    <WorkFrame Title="@WorkTitle" Accountant="@WorkService.IsAccountant(viewer)">
        @if (viewer is null)
        {
            <StateMessage IconName="lock" Title="Sign in to see your workspace" Text="Client lists, service progress and documents are private.">
                <a class="btn btn-primary" href="@AccountEndpoints.SignInPageAddress(original)">Sign in</a>
            </StateMessage>
        }
        else
        {
            <WorkUnavailable />
        }
    </WorkFrame>
}
else if (kind == Kind.Chat && viewer is null)
{
    @* The same state as a visitor at a conversation address (ChatThreadPage). *@
    <SeoHead Title="Chat · Tax Buddy" Description="A conversation on Tax Buddy." CanonicalPath="/chats" />
    <StateMessage IconName="chat" HeadingLevel="1" Title="Sign in to see this chat">
        <a class="btn btn-primary" href="@AccountEndpoints.SignInPageAddress(original)">Sign in</a>
    </StateMessage>
}
else if (kind == Kind.Chat)
{
    @* F07 CH07: someone else's conversation or an unknown one; nothing about it is shown. *@
    <SeoHead Title="Conversation not available · Tax Buddy" Description="This conversation isn't available." CanonicalPath="/chats" />
    <ChatPanes Mode="@ChatPanes.UnavailableMode" DetailTitle="Chat" StateTitle="This conversation isn't available"
               StateText="It may have been removed, or it belongs to a different account." StateHref="/chats" StateLink="Back to chats" />
}
else if (kind == Kind.NewChat)
{
    @* F07 CH08 (prototype threadParts "compose"): the accountant's profile is unlisted, removed or unknown. *@
    <SeoHead Title="Accountant not available · Tax Buddy" Description="This accountant is no longer available." CanonicalPath="/" />
    <ChatPanes Mode="@ChatPanes.UnavailableMode" DetailTitle="Chat" StateTitle="This accountant is no longer available"
               StateHref="/" StateLink="Back to directory" />
}
else if (kind == Kind.Review)
{
    @* F09 (prototype d-review and reviewPageHTML): the state sits in the "Write a review" panel, under "Back to profile". *@
    <SeoHead Title="Accountant not available · Tax Buddy" Description="This accountant is no longer available." CanonicalPath="/" />
    <div class="narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="@ReviewedProfilePath">Back to profile</a></nav>
        <div class="panel titled">
            <h1 id="page-title" tabindex="-1">Write a review</h1>
            <StateMessage IconName="alert" Title="This accountant is no longer available">
                <a class="btn" href="/">Back to directory</a>
            </StateMessage>
        </div>
    </div>
}
else if (kind == Kind.Report)
{
    @* F10: the reported item is gone, unlisted, or a conversation the viewer isn't part of; nothing about it is shown. *@
    <SeoHead Title="Not available · Tax Buddy" Description="This item isn't available to report." CanonicalPath="/" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="This isn't available" Text="It may have been removed, or the link is wrong.">
        <a class="btn" href="/">Back to directory</a>
    </StateMessage>
}
else if (kind == Kind.Profile)
{
    @* Prototype profileBodyHTML's unavailable state. *@
    <SeoHead Title="Profile no longer available · Tax Buddy" Description="This accountant profile is no longer available." CanonicalPath="/" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="This profile is no longer available"
                  Text="The accountant may have removed their profile, or the link is wrong.">
        <a class="btn" href="/">Back to directory</a>
    </StateMessage>
}
else
{
    @* The prototype's infoPage default case: a narrow panel titled "Page not found" holding the state. *@
    <SeoHead Title="Page not found · Tax Buddy" Description="This page does not exist." CanonicalPath="/" />
    <div class="narrow">
        <article class="panel prose info-state" aria-labelledby="page-title">
            <h1 id="page-title" tabindex="-1">Page not found</h1>
            <StateMessage IconName="search" Title="We couldn't find that page" Text="The link may be old or mistyped.">
                <a class="btn btn-primary" href="/">Go to the directory</a>
            </StateMessage>
        </article>
    </div>
}

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private enum Kind { Page, Profile, Review, Chat, NewChat, Report, Work, Request }

    private Kind kind;
    private string original = "/";
    private TaxBuddy.Web.Application.Chat.ChatViewer? viewer;

    private bool OnClients => original.StartsWith("/clients/", StringComparison.OrdinalIgnoreCase);

    /// <summary>The prototype's workspace titles (service-workspace.js page).</summary>
    private string WorkTitle => kind == Kind.Request ? "Request a service" : OnClients ? "Client services" : "Service progress";

    /// <summary>"/accountants/{id}/review" → "/accountants/{id}".</summary>
    private string ReviewedProfilePath => original.TrimEnd('/')[..^"/review".Length];

    private string PhoneTitle => kind switch
    {
        Kind.Profile => "Profile",
        Kind.Chat or Kind.NewChat => "Chat",
        Kind.Review => "Write a review",
        Kind.Report => "Report",
        Kind.Work or Kind.Request => WorkTitle,
        _ => "Page not found",
    };

    private string PhoneBack => kind switch
    {
        Kind.Chat => "/chats",
        Kind.Work or Kind.Request => viewer is null ? "/" : "/workspace",
        Kind.Review => ReviewedProfilePath,
        _ => "/",
    };

    protected override void OnInitialized()
    {
        // Re-executed for a 404: the feature holds the address the visitor asked for. Rendered in place: the request path is it.
        original = HttpContext?.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath ?? HttpContext?.Request.Path.Value ?? "/";
        viewer = ChatDisplay.ViewerOf(HttpContext?.User);
        kind = original switch
        {
            { } path when path.StartsWith("/work/", StringComparison.OrdinalIgnoreCase)
                          || path.StartsWith("/clients/", StringComparison.OrdinalIgnoreCase) => Kind.Work,
            { } path when path.StartsWith("/accountants/", StringComparison.OrdinalIgnoreCase)
                          && path.TrimEnd('/').EndsWith("/review", StringComparison.OrdinalIgnoreCase) => Kind.Review,
            { } path when path.StartsWith("/accountants/", StringComparison.OrdinalIgnoreCase)
                          && path.TrimEnd('/').EndsWith("/request-service", StringComparison.OrdinalIgnoreCase) => Kind.Request,
            { } path when path.StartsWith("/accountants/", StringComparison.OrdinalIgnoreCase) => Kind.Profile,
            { } path when path.StartsWith("/chats/new/", StringComparison.OrdinalIgnoreCase) => Kind.NewChat,
            { } path when path.StartsWith("/report/", StringComparison.OrdinalIgnoreCase) => Kind.Report,
            { } path when path.StartsWith("/chats/", StringComparison.OrdinalIgnoreCase) => Kind.Chat,
            _ => Kind.Page,
        };
    }
}
