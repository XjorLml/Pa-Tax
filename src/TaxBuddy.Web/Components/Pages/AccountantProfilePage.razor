@page "/accountants/{Id}"
@* F01 profile (PRD R03, R11, BR01; FT04, FT05, FT06). Static server rendering. Reviews and the accountant's reply form
   came with R13 and R14 (F09): the reply is a named form posted to this page (SDD render modes). *@
@using TaxBuddy.Web.Application.Chat
@using TaxBuddy.Web.Application.Reviews
@using TaxBuddy.Web.Components.Chat
@inject TaxBuddy.Web.Account.AccountService Accounts
@inject TaxBuddy.Web.Application.Work.WorkService Work
@inject DirectoryService Directory
@inject ReviewService ReviewService
@inject ChatService Chat
@inject TaxBuddy.Web.Domain.IClock Clock
@inject NavigationManager Navigation

<PhoneBar Title="Profile" Back="/" />

@if (failed)
{
    <SeoHead Title="Profile unavailable · Tax Buddy" Description="This profile could not be loaded." CanonicalPath="@($"/accountants/{Id}")" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="We couldn't load this profile" Text="That's a problem on our side, not yours. Please try again.">
        <a class="btn btn-primary" href="@($"/accountants/{Uri.EscapeDataString(Id ?? "")}")">Try again</a>
        <a class="btn" href="/">Back to directory</a>
    </StateMessage>
}
else if (profile is not null)
{
    <SeoHead Title="@($"{profile.Name}, {profile.Title} · Tax Buddy")" Description="@Excerpt(profile.Summary)"
             CanonicalPath="@Display.ProfilePath(profile.Id)" />

    @* The prototype's profile (profileBodyHTML, Tax Buddy look; F02 BD10). Portfolio highlights came with R12 (F08), the
       rating and reviews with R13 and R14 (F09), the report links with R15 (F10). *@
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Accountants</a><span aria-hidden="true">/</span><span>@profile.Name</span>
    </nav>
    <div class="profile-grid">
        <article class="profile-main" aria-labelledby="page-title">
            <div class="profile-head">
                <Avatar Name="@profile.Name" Picture="@profile.PictureAddress" Size="lg" />
                <div class="min-w-0">
                    <h1 id="page-title" tabindex="-1">@profile.Name</h1>
                    <p class="sub">@profile.Title</p>
                    @if (profile.City is not null)
                    {
                        <p class="sub"><Icon Name="pin" Size="14" /> @profile.City</p>
                    }
                    <p class="rating"><a class="rating-link" href="#reviews-heading"><RatingLine Rating="@reviews.Rating" /></a></p>
                </div>
            </div>
            <ul class="facts-row">
                @if (reviews.Rating.Average is { } average)
                {
                    <li><strong>@Display.Rating(average)</strong> average from @Display.ReviewCount(reviews.Rating.Count)</li>
                }
                @if (profile.YearsOfExperience is { } years)
                {
                    <li><strong>@years</strong> @(years == 1 ? "year" : "years") of experience</li>
                }
                <li><strong>@profile.Services.Count</strong> @(profile.Services.Count == 1 ? "service" : "services")</li>
            </ul>

            <section class="section" aria-labelledby="about-heading">
                <h2 id="about-heading" class="section-title">About</h2>
                <p class="whitespace-pre-line">@profile.Summary</p>
            </section>
            <section class="section" aria-labelledby="services-heading">
                <h2 id="services-heading" class="section-title">Services</h2>
                <ul class="svc">
                    @foreach (var service in profile.Services)
                    {
                        <li>
                            <strong>@service.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <span class="muted small">@service.Description</span>
                            }
                        </li>
                    }
                </ul>
                <p class="muted small mt-2">Prices aren't listed. Ask in chat.</p>
            </section>
            @if (profile.Highlights.Count > 0)
            {
                @* F08 (prototype profileBodyHTML): between Services and Experience. *@
                <section class="section" aria-labelledby="portfolio-heading">
                    <h2 id="portfolio-heading" class="section-title">Portfolio highlights</h2>
                    <ul class="pf">
                        @foreach (var highlight in profile.Highlights)
                        {
                            <li>
                                <div class="pf-top">
                                    <strong>@highlight.Title</strong>
                                    @if (highlight.ClientType is not null)
                                    {
                                        <span class="tag">@highlight.ClientType</span>
                                    }
                                </div>
                                <p class="whitespace-pre-line">@highlight.Work</p>
                                @if (highlight.Result is not null)
                                {
                                    <p class="pf-result"><span class="muted small">Result</span> @highlight.Result</p>
                                }
                            </li>
                        }
                    </ul>
                    <p class="muted small mt-2">Described by the accountant. Client names are left out.</p>
                </section>
            }
            <section class="section" aria-labelledby="experience-heading">
                <h2 id="experience-heading" class="section-title">Experience</h2>
                @if (profile.Experience.Count > 0)
                {
                    <ol class="timeline">
                        @foreach (var entry in profile.Experience)
                        {
                            <li>
                                <strong>@entry.Role</strong>@entry.Organization<br />
                                <span class="muted small">@entry.From – @(entry.Until ?? "Present")</span>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p class="muted">No experience listed.</p>
                }
            </section>

            @* F09 (prototype reviewsHTML; PRD R13, R14, BR09–BR11). *@
            <section class="section" aria-labelledby="reviews-heading">
                <h2 id="reviews-heading" class="section-title" tabindex="-1">Reviews</h2>
                @if (SavedText is { } saved)
                {
                    <p class="save-status ok" role="status">@saved</p>
                }
                else if (Reported == "review")
                {
                    <p class="save-status ok" role="status">@ReportThanks</p>
                }
                <div class="rev-head">
                    <div class="rev-sum">
                        @if (reviews.Rating.Average is { } summaryAverage)
                        {
                            <strong class="rev-avg">@Display.Rating(summaryAverage)</strong>
                            <Stars Value="summaryAverage" />
                            <span class="muted">@Display.ReviewCount(reviews.Rating.Count)</span>
                        }
                        else
                        {
                            <span class="muted">No reviews yet.</span>
                        }
                    </div>
                    @if (reviews.Access == ReviewAccess.Allowed)
                    {
                        <a class="btn btn-sm" href="@Display.ReviewPath(profile.Id)">@(reviews.HasReview ? "Edit your review" : "Write a review")</a>
                    }
                </div>
                @if (!reviews.IsOwner)
                {
                    var first = Display.FirstName(profile.Name);
                    switch (reviews.Access)
                    {
                        case ReviewAccess.SignIn:
                            <p class="muted small">Reviews come from clients @first has chatted with. <a href="@TaxBuddy.Web.Account.AccountEndpoints.SignInPageAddress(Display.ProfilePath(profile.Id))">Sign in</a> if that's you.</p>
                            break;
                        case ReviewAccess.NoReplyYet:
                            <p class="muted small">You can review @first after they reply to a message from you.</p>
                            break;
                        case ReviewAccess.NotAClient:
                            <p class="muted small">Only clients can write reviews.</p>
                            break;
                        case ReviewAccess.Blocked:
                            @* F10: blocked by the accountant; not told why. Their own review can still be deleted. *@
                            <p class="muted small">
                                You can't review @first.
                                @if (reviews.HasReview)
                                {
                                    <a href="@Display.ReviewPath(profile.Id)">Delete your review</a>
                                }
                            </p>
                            break;
                    }
                }
                @if (reviews.Reviews.Count > 0)
                {
                    <ul class="revs">
                        @foreach (var review in reviews.Reviews)
                        {
                            <li class="rev" id="@($"review-{review.Id:D}")">
                                <div class="rev-top">
                                    <Stars Value="review.Stars" />
                                    <span class="rev-who">@review.ReviewerName@(review.IsMine ? " (you)" : "")</span>
                                    <span class="time">@ChatDisplay.Short(review.At, Clock.UtcNow)</span>
                                </div>
                                @if (review.Text is not null)
                                {
                                    <p class="whitespace-pre-line">@review.Text</p>
                                }
                                @if (reviews.IsOwner && editingReply == review.Id)
                                {
                                    <form method="post" @formname="reply" @onsubmit="ReplyAsync" class="rev-reply" novalidate>
                                        <AntiforgeryToken />
                                        <input type="hidden" name="Reply.ReviewId" value="@review.Id.ToString("D")" />
                                        <label for="reply-text"><strong>Your public reply</strong></label>
                                        <textarea id="reply-text" name="Reply.Text" rows="3" maxlength="@TaxBuddy.Web.Domain.ReviewLimits.Reply"
                                                  aria-invalid="@(replyError is null ? null : "true")"
                                                  aria-describedby="@(replyError is null ? null : "reply-error")">@(Reply?.Text ?? review.ReplyText)</textarea>
                                        @if (replyError is not null)
                                        {
                                            <span class="ferr" id="reply-error" role="alert">@replyError</span>
                                        }
                                        <div class="actions">
                                            <button type="submit" class="btn btn-primary btn-sm">Post reply</button>
                                            <a class="btn btn-sm" href="@($"{Display.ProfilePath(profile.Id)}#review-{review.Id:D}")">Cancel</a>
                                        </div>
                                    </form>
                                }
                                else if (review.ReplyText is not null)
                                {
                                    <div class="rev-reply">
                                        <strong>Reply from @Display.FirstName(profile.Name)</strong>
                                        <p class="whitespace-pre-line">@review.ReplyText</p>
                                        @if (reviews.IsOwner)
                                        {
                                            <a class="linkbtn" href="@ReplyEditPath(review.Id)">Edit reply</a>
                                        }
                                    </div>
                                }
                                else if (reviews.IsOwner)
                                {
                                    <a class="btn btn-sm rev-reply-btn" href="@ReplyEditPath(review.Id)">Reply</a>
                                }
                                @if (viewer is not null && !review.IsMine)
                                {
                                    @* F10 (prototype reviewsHTML): signed-in users other than the author. *@
                                    <a class="linkbtn rev-report" href="@($"/report/review/{review.Id:D}")">Report this review</a>
                                }
                            </li>
                        }
                    </ul>
                }
                <p class="muted small mt-2.5">Only clients this accountant has replied to can leave a review. Tax Buddy doesn't edit or check reviews.</p>
            </section>
        </article>

        <aside class="profile-aside" aria-label="Contact">
            <div class="aside-card">
                @* F07: Message opens a new chat, or the existing conversation (D06: one per client and accountant). *@
                <div class="aside-cta">@ProfileAction</div>
                <h2>Contact</h2>
                <ul class="contact">
                    <li>
                        <Icon Name="mail" Size="18" />
                        <span class="sr-only">Email:</span>
                        <a href="mailto:@profile.Email" class="text-text">@profile.Email</a>
                    </li>
                    @if (profile.Phone is not null)
                    {
                        <li>
                            <Icon Name="phone" Size="18" />
                            <span class="sr-only">Phone:</span>
                            @if (Display.TelHref(profile.Phone) is { } tel)
                            {
                                <a href="@tel" class="text-text">@profile.Phone</a>
                            }
                            else
                            {
                                <span>@profile.Phone</span>
                            }
                        </li>
                    }
                    @if (profile.Website is not null)
                    {
                        <li>
                            <Icon Name="globe" Size="18" />
                            <span class="sr-only">Website:</span>
                            @if (profile.WebsiteHref is { } href)
                            {
                                <a href="@href" rel="nofollow ugc noopener noreferrer" class="text-text">@profile.Website</a>
                            }
                            else
                            {
                                <span>@profile.Website</span>
                            }
                        </li>
                    }
                </ul>
                <p class="muted small mt-2">Shown publicly by the accountant.</p>
            </div>
            <p class="note"><Icon Name="info" Size="18" /><span>Accountants write their own profiles. Tax Buddy doesn't check licences or qualifications, so read the reviews, ask about credentials in your chat, and check a CPA's licence with the PRC.</span></p>
            @if (!reviews.IsOwner)
            {
                @* F10 (prototype profileBodyHTML report-row): everyone but the owner; a visitor signs in on the report page. *@
                <p class="report-row">
                    @if (Reported == "profile")
                    {
                        <span class="save-status ok" role="status">@ReportThanks</span>
                    }
                    else
                    {
                        <a class="linkbtn" href="@($"/report/profile/{profile.Id}")">Report this profile</a>
                    }
                </p>
            }
        </aside>
    </div>

    @* Phones: the Message action stays in a bar under the content, as in the prototype. *@
    <div class="phone-cta">@ProfileAction</div>
}

@code {
    [Parameter] public string? Id { get; set; }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "reply")] private ReplyForm? Reply { get; set; }

    /// <summary>The review whose reply the owner is writing (prototype "Reply" and "Edit reply"); a plain link opens it.</summary>
    [SupplyParameterFromQuery(Name = "reply")] public string? ReplyTo { get; set; }

    /// <summary>What was just saved, after the redirect: the prototype's toast as a status line.</summary>
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    /// <summary>After a report (F10): "profile" or "review", for the thanks line.</summary>
    [SupplyParameterFromQuery(Name = "reported")] public string? Reported { get; set; }

    private const string ReportThanks = "Thanks. Your report was sent to the Tax Buddy team.";

    private AccountantProfileView? profile;
    private ProfileReviews reviews = ProfileReviews.Empty;
    private ChatViewer? viewer;
    private Guid? existingChat;
    private bool isSaved;
    private string providers = "Google";
    private bool takesRequests;

    /// <summary>
    /// The prototype's profileAction for this viewer: the owner and other accountants get a note; a client with a chat gets
    /// "Open chat"; everyone else "Message {first}" with its hint. Shown in the contact card and, on phones, in the bar.
    /// </summary>
    private RenderFragment ProfileAction => __builder =>
    {
        if (reviews.IsOwner)
        {
            <p class="note"><span>This is your public profile. <a href="/account/profile">Edit profile</a></span></p>
        }
        else if (viewer is { IsClient: false })
        {
            <p class="note"><span>You're signed in as an accountant. Only clients can start chats.</span></p>
        }
        else if (existingChat is { } chat)
        {
            <a class="btn btn-primary btn-block" href="@ChatDisplay.ThreadPath(chat)"><Icon Name="chat" Size="18" />Open chat</a>
        }
        else
        {
            <a class="btn btn-primary btn-block" href="@($"/chats/new/{profile!.Id}")"><Icon Name="chat" Size="18" />Message @Display.FirstName(profile.Name)</a>
            <p class="cta-hint">@(viewer is null ? $"It's free to send a message. You'll sign in with {providers} before it's sent." : "It's free to send a message. Ask about pricing in the chat.")</p>
        }
        @if (viewer is { IsClient: true } && profile is not null)
        {
            @* F03 (R20, BR14): prototype profileAction's workspace part. Adding is private; a request shares the client's name. *@
            <div class="work-profile-actions">
                @if (isSaved)
                {
                    <a class="btn btn-block" href="/workspace">Added · My accountants</a>
                }
                else
                {
                    <form method="post" action="@TaxBuddy.Web.Services.WorkEndpoints.SavedPath">
                        <AntiforgeryToken />
                        <input type="hidden" name="profileId" value="@profile.Id.Value" />
                        <input type="hidden" name="on" value="true" />
                        <input type="hidden" name="returnUrl" value="@($"/accountants/{profile.Id.Value}")" />
                        <button type="submit" class="btn btn-block">Add accountant</button>
                    </form>
                }
                @if (takesRequests)
                {
                    <a class="btn btn-ghost btn-block" href="@($"/accountants/{profile.Id.Value}/request-service")">Request a service</a>
                }
                <p class="cta-hint">Adding is private. Request a service when you are ready.</p>
            </div>
        }
    };
    private Guid? editingReply;
    private string? replyError;
    private bool failed;

    private string? SavedText => Saved switch
    {
        "review-posted" => "Your review was posted.",
        "review-updated" => "Your review was updated.",
        "review-deleted" => "Your review was deleted.",
        "reply" => "Your reply was posted.",
        "added" => "Accountant added to your private list.",
        "failed" => "We couldn't change your list. Please try again.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        viewer = ChatDisplay.ViewerOf(HttpContext?.User);
        providers = await Accounts.ProviderNamesAsync();
        try
        {
            profile = await Directory.GetProfileAsync(Id);
            if (profile is null)
            {
                // Blazor sends no body with a page-set 404; the not-found page renders "no longer available" for this address (FT05).
                Navigation.NotFound();
                return;
            }

            reviews = await ReviewService.ForProfileAsync(viewer, profile.Id);
            if (viewer is { IsClient: true })
            {
                // Prototype profileAction: a client who already has a chat gets "Open chat" (D06: one per pair).
                existingChat = (await Chat.PrepareNewChatAsync(viewer, profile.Id)).ConversationId;
                isSaved = await Work.IsSavedAsync(viewer, profile.Id);
                takesRequests = await Work.RequestTargetAsync(viewer, profile.Id) is not null;
            }
        }
        catch (DataUnavailableException)
        {
            failed = true;
            SetStatus(StatusCodes.Status503ServiceUnavailable);
            return;
        }

        if (reviews.IsOwner && Guid.TryParse(Reply?.ReviewId ?? ReplyTo, out var reviewId) && reviews.Reviews.Any(r => r.Id == reviewId))
        {
            editingReply = reviewId;
        }
    }

    /// <summary>R14: the owner's reply. The service checks the owner again; a failed post keeps the text.</summary>
    private async Task ReplyAsync()
    {
        if (profile is null || Reply is null)
        {
            return;
        }

        Guid.TryParse(Reply.ReviewId, out var reviewId);
        var result = await ReviewService.ReplyAsync(viewer, profile.Id, reviewId, Reply.Text);
        switch (result.Outcome)
        {
            case ReplyOutcome.Posted:
                // SDD forms: redirect, so a reload doesn't post again.
                Navigation.NavigateTo($"{Display.ProfilePath(profile.Id)}?saved=reply#review-{reviewId:D}");
                break;
            case ReplyOutcome.Invalid:
                replyError = result.Error;
                SetStatus(StatusCodes.Status422UnprocessableEntity);
                break;
            case ReplyOutcome.NotAllowed:
                editingReply = null;
                SetStatus(StatusCodes.Status403Forbidden);
                break;
            default:
                replyError = "Not posted: we couldn't reach the server. Your reply is still here.";
                SetStatus(StatusCodes.Status503ServiceUnavailable);
                break;
        }
    }

    private string ReplyEditPath(Guid reviewId) => $"{Display.ProfilePath(profile!.Id)}?reply={reviewId:D}#reply-text";

    private void SetStatus(int status) => ResponseStatus.Set(HttpContext, status);

    private static string Excerpt(string text) => text.Length <= 155 ? text : text[..152].TrimEnd() + "…";
}
