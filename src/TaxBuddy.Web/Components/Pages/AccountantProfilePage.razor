@page "/accountants/{Id}"
@* F01 profile (PRD R03, R11, BR01; FT04, FT05, FT06). Static server rendering. *@
@inject DirectoryService Directory
@inject NavigationManager Navigation

<PhoneBar Title="Profile" Back="/" />

@if (failed)
{
    <SeoHead Title="Profile unavailable · Tax Buddy" Description="This profile could not be loaded." CanonicalPath="@($"/accountants/{Id}")" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="We couldn't load this profile" Text="That's a problem on our side, not yours. Please try again.">
        <a class="btn btn-primary" href="@($"/accountants/{Uri.EscapeDataString(Id ?? "")}")">Try again</a>
        <a class="btn" href="/">Back to the directory</a>
    </StateMessage>
}
else if (profile is not null)
{
    <SeoHead Title="@($"{profile.Name}, {profile.Title} · Tax Buddy")" Description="@Excerpt(profile.Summary)"
             CanonicalPath="@Display.ProfilePath(profile.Id)" />

    @* The prototype's profile (profileBodyHTML, Tax Buddy look; F02 BD10). Its rating, portfolio highlights, reviews and
       "Report this profile" join with R13, R12 and R15. *@
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Accountants</a><span aria-hidden="true">/</span><span>@profile.Name</span>
    </nav>
    <div class="profile-grid">
        <article class="profile-main" aria-labelledby="page-title">
            <div class="profile-head">
                <Avatar Name="@profile.Name" Picture="@profile.PictureAddress" Size="lg" />
                <div class="min-w-0">
                    <h1 id="page-title" tabindex="-1">@profile.Name</h1>
                    <p class="sub">@profile.Title</p>
                    @if (profile.City is not null)
                    {
                        <p class="sub"><Icon Name="pin" Size="14" /> @profile.City</p>
                    }
                </div>
            </div>
            <ul class="facts-row">
                @if (profile.YearsOfExperience is { } years)
                {
                    <li><strong>@years</strong> @(years == 1 ? "year" : "years") of experience</li>
                }
                <li><strong>@profile.Services.Count</strong> @(profile.Services.Count == 1 ? "service" : "services")</li>
            </ul>

            <section class="section" aria-labelledby="about-heading">
                <h2 id="about-heading" class="section-title">About</h2>
                <p class="whitespace-pre-line">@profile.Summary</p>
            </section>
            <section class="section" aria-labelledby="services-heading">
                <h2 id="services-heading" class="section-title">Services</h2>
                <ul class="svc">
                    @foreach (var service in profile.Services)
                    {
                        <li>
                            <strong>@service.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <span class="muted small">@service.Description</span>
                            }
                        </li>
                    }
                </ul>
                <p class="muted small mt-2">Prices aren't listed. Ask in chat.</p>
            </section>
            <section class="section" aria-labelledby="experience-heading">
                <h2 id="experience-heading" class="section-title">Experience</h2>
                @if (profile.Experience.Count > 0)
                {
                    <ol class="timeline">
                        @foreach (var entry in profile.Experience)
                        {
                            <li>
                                <strong>@entry.Role</strong>@entry.Organization<br />
                                <span class="muted small">@entry.From – @(entry.Until ?? "Present")</span>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p class="muted">No experience listed.</p>
                }
            </section>
        </article>

        <aside class="profile-aside" aria-label="Contact">
            <div class="aside-card">
                @* F01 exclusion: messaging (R06) is shown but leads to a "coming soon" page in this slice. *@
                <div class="aside-cta">
                    <a class="btn btn-primary btn-block" href="@($"/chats/new/{profile.Id}")"><Icon Name="chat" Size="18" />Message @Display.FirstName(profile.Name)</a>
                    <p class="cta-hint">It's free to send a message. You'll sign in with Google before it's sent.</p>
                </div>
                <h2>Contact</h2>
                <ul class="contact">
                    <li>
                        <Icon Name="mail" Size="18" />
                        <span class="sr-only">Email:</span>
                        <a href="mailto:@profile.Email" class="text-text">@profile.Email</a>
                    </li>
                    @if (profile.Phone is not null)
                    {
                        <li>
                            <Icon Name="phone" Size="18" />
                            <span class="sr-only">Phone:</span>
                            @if (Display.TelHref(profile.Phone) is { } tel)
                            {
                                <a href="@tel" class="text-text">@profile.Phone</a>
                            }
                            else
                            {
                                <span>@profile.Phone</span>
                            }
                        </li>
                    }
                    @if (profile.Website is not null)
                    {
                        <li>
                            <Icon Name="globe" Size="18" />
                            <span class="sr-only">Website:</span>
                            @if (profile.WebsiteHref is { } href)
                            {
                                <a href="@href" rel="nofollow ugc noopener noreferrer" class="text-text">@profile.Website</a>
                            }
                            else
                            {
                                <span>@profile.Website</span>
                            }
                        </li>
                    }
                </ul>
                <p class="muted small mt-2">Shown publicly by the accountant.</p>
            </div>
            <p class="note"><Icon Name="info" Size="18" /><span>Accountants write their own profiles. Tax Buddy doesn't check licences or qualifications, so ask about credentials in your chat.</span></p>
        </aside>
    </div>

    @* Phones: the Message action stays in a bar under the content, as in the prototype. *@
    <div class="phone-cta">
        <a class="btn btn-primary btn-block" href="@($"/chats/new/{profile.Id}")"><Icon Name="chat" Size="18" />Message @Display.FirstName(profile.Name)</a>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private AccountantProfileView? profile;
    private bool failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Directory.GetProfileAsync(Id);
            if (profile is null)
            {
                // Blazor sends no body with a page-set 404; the not-found page renders "no longer available" for this address (FT05).
                Navigation.NotFound();
            }
        }
        catch (DataUnavailableException)
        {
            failed = true;
            SetStatus(StatusCodes.Status503ServiceUnavailable);
        }
    }

    private void SetStatus(int status) => ResponseStatus.Set(HttpContext, status);

    private static string Excerpt(string text) => text.Length <= 155 ? text : text[..152].TrimEnd() + "…";
}
