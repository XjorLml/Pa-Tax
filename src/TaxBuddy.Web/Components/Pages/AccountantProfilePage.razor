@page "/accountants/{Id}"
@* F01 profile (PRD R03, R11, BR01; FT04, FT05, FT06). Static server rendering. *@
@inject DirectoryService Directory
@inject NavigationManager Navigation

@if (failed)
{
    <SeoHead Title="Profile unavailable · Tax Buddy" Description="This profile could not be loaded." CanonicalPath="@($"/accountants/{Id}")" />
    <StateMessage IconName="alert" HeadingLevel="1" Title="We couldn't load this profile" Text="That's a problem on our side, not yours. Please try again.">
        <a class="btn btn-primary" href="@($"/accountants/{Uri.EscapeDataString(Id ?? "")}")">Try again</a>
        <a class="btn" href="/">Back to the directory</a>
    </StateMessage>
}
else if (profile is not null)
{
    <SeoHead Title="@($"{profile.Name}, {profile.Title} · Tax Buddy")" Description="@Excerpt(profile.Summary)"
             CanonicalPath="@Display.ProfilePath(profile.Id)" />

    <p class="mb-4">
        <a href="/" class="inline-flex min-h-11 items-center gap-1 font-semibold no-underline"><Icon Name="back" Size="16" />All accountants</a>
    </p>

    <div class="grid gap-6 md:grid-cols-[1fr_300px] md:items-start">
        <article class="flex flex-col gap-6 rounded-2xl border border-border bg-surface p-5 md:p-7" aria-labelledby="page-title">
            <header class="flex items-start gap-4">
                <span class="grid size-16 flex-none place-items-center rounded-[14px] bg-primary-soft font-heading text-[24px] text-on-soft" aria-hidden="true">@Display.Initials(profile.Name)</span>
                <div class="min-w-0">
                    <h1 id="page-title" class="text-[28px] md:text-[34px]" tabindex="-1">@profile.Name</h1>
                    <p class="text-[15px] text-muted">@profile.Title</p>
                    @if (profile.City is not null || profile.YearsOfExperience is not null)
                    {
                        <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-[13.5px] text-muted">
                            @if (profile.City is not null)
                            {
                                <span class="inline-flex items-center gap-1"><Icon Name="pin" Size="14" />@profile.City</span>
                            }
                            @if (profile.YearsOfExperience is { } years)
                            {
                                <span>@Display.YearsOfExperience(years)</span>
                            }
                        </p>
                    }
                </div>
            </header>

            <section aria-labelledby="about-heading">
                <h2 id="about-heading" class="text-[22px]">About</h2>
                <p class="mt-2 whitespace-pre-line">@profile.Summary</p>
            </section>

            <section aria-labelledby="services-heading">
                <h2 id="services-heading" class="text-[22px]">Services</h2>
                <ul class="mt-3 grid gap-3">
                    @foreach (var service in profile.Services)
                    {
                        <li class="rounded-xl border border-border p-4">
                            <p class="font-semibold">@service.Name</p>
                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <p class="text-[14px] text-muted">@service.Description</p>
                            }
                        </li>
                    }
                </ul>
                <p class="mt-2 text-[13px] text-muted">Prices aren't listed. Ask the accountant about fees.</p>
            </section>

            @if (profile.Experience.Count > 0)
            {
                <section aria-labelledby="experience-heading">
                    <h2 id="experience-heading" class="text-[22px]">Experience</h2>
                    <ol class="mt-3 grid gap-3 border-l-2 border-border pl-4">
                        @foreach (var entry in profile.Experience)
                        {
                            <li>
                                <p class="font-semibold">@entry.Role</p>
                                <p class="text-[14px]">@entry.Organization</p>
                                <p class="text-[13px] text-muted">@entry.From – @(entry.Until ?? "Present")</p>
                            </li>
                        }
                    </ol>
                </section>
            }
        </article>

        <aside class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-5 md:sticky md:top-4" aria-labelledby="contact-heading">
            <h2 id="contact-heading" class="text-[22px]">Contact</h2>
            <ul class="grid gap-3 text-[14px]">
                <li class="flex items-center gap-2 break-all">
                    <Icon Name="mail" Size="16" Class="flex-none text-muted" />
                    <span class="sr-only">Email:</span>
                    <a href="mailto:@profile.Email">@profile.Email</a>
                </li>
                @if (profile.Phone is not null)
                {
                    <li class="flex items-center gap-2">
                        <Icon Name="phone" Size="16" Class="flex-none text-muted" />
                        <span class="sr-only">Phone:</span>
                        @if (Display.TelHref(profile.Phone) is { } tel)
                        {
                            <a href="@tel">@profile.Phone</a>
                        }
                        else
                        {
                            <span>@profile.Phone</span>
                        }
                    </li>
                }
                @if (profile.Website is not null)
                {
                    <li class="flex items-center gap-2 break-all">
                        <Icon Name="globe" Size="16" Class="flex-none text-muted" />
                        <span class="sr-only">Website:</span>
                        @if (profile.WebsiteHref is { } href)
                        {
                            <a href="@href" rel="nofollow ugc noopener noreferrer">@profile.Website</a>
                        }
                        else
                        {
                            <span>@profile.Website</span>
                        }
                    </li>
                }
            </ul>
            @* F01 exclusion: messaging (R06) is shown but leads to a "coming soon" page in this slice. *@
            <a class="btn btn-primary w-full" href="@($"/chats/new/{profile.Id}")"><Icon Name="chat" Size="18" />Message @Display.FirstName(profile.Name)</a>
            <p class="text-[12.5px] text-muted">The accountant chose to show these contact details.</p>
        </aside>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private AccountantProfileView? profile;
    private bool failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Directory.GetProfileAsync(Id);
            if (profile is null)
            {
                // Blazor sends no body with a page-set 404; the not-found page renders "no longer available" for this address (FT05).
                Navigation.NotFound();
            }
        }
        catch (DataUnavailableException)
        {
            failed = true;
            SetStatus(StatusCodes.Status503ServiceUnavailable);
        }
    }

    private void SetStatus(int status) => ResponseStatus.Set(HttpContext, status);

    private static string Excerpt(string text) => text.Length <= 155 ? text : text[..152].TrimEnd() + "…";
}
