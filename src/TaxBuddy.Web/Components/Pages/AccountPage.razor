@page "/account"
@using System.Security.Claims
@using TaxBuddy.Web.Account
@using TaxBuddy.Web.Application.Profiles
@using TaxBuddy.Web.Domain
@inject ProfileEditorService Editor
@inject TaxBuddy.Web.Application.Pictures.ProfilePictureService Pictures
@inject EmailPreferences EmailSettings
@inject ClientDetailsService ClientDetailsData
@inject NavigationManager Navigation
@* Account (prototype meHTML; F02 BD10). Static. Rows joined as their features were built: account deletion (R09) in
   F12, email notifications (R08) in F14, and service work (F03) on 2026-11-24. The accountant's "My reviews" row is
   left out by the user's choice (F09, 2026-11-17; kept on 2026-11-24). A client's "Your details" card (F17, R25; prototype
   clientDetailsCardHTML, F02 BD15) shows their details; ?edit=details turns it into a named form posted to this page. *@

<SeoHead Title="Account · Tax Buddy" Description="Your Tax Buddy account." CanonicalPath="/account" />
<PhoneBar Title="Account" />
<PhoneTabs Current="account" />
<DeskTitle Title="Account" />

<div class="single-inner">

    @if (user is null)
    {
        <div class="me-card">
            <span class="avatar lg" aria-hidden="true"><Icon Name="user" Size="30" /></span>
            <div>
                <h2>You're browsing as a visitor</h2>
                <p class="sub">Sign in to message accountants, or to publish your profile as an accountant.</p>
            </div>
        </div>
        <a class="btn btn-primary btn-block" href="@AccountEndpoints.SignInPageAddress("/account")">Sign in</a>
    }
    else
    {
        @* F06 PP10 (prototype option E, meCardHTML): with script, the pencil opens the device's file chooser, the chosen
           photo is previewed in the avatar, and Save posts the upload form below (wwwroot/TaxBuddy.Web.lib.module.js).
           Without script the pencil is a plain link to #picture and the panel shows while it is the page's target (PP09). *@
        <div class="picture-area" data-picture="@(Pictures.IsAvailable ? "on" : null)">
        <div class="me-card">
            @if (Pictures.IsAvailable)
            {
                <a class="avatar-edit" href="#picture" aria-label="Change profile picture" data-picture-pencil>
                    <Avatar Name="@name" Picture="@picture" Size="lg" />
                    <span class="pencil"><Icon Name="edit" Size="14" /></span>
                </a>
            }
            else
            {
                <Avatar Name="@name" Picture="@picture" Size="lg" />
            }
            <div>
                <h2>@name</h2>
                <p class="sub">@(isAccountant ? "Accountant" : "Client") · Signed in with @provider</p>
                @if (Pictures.IsAvailable)
                {
                    @* Shown by the script only: without it, Save and Remove are in the panel. *@
                    <div class="pic-confirm" data-picture-confirm hidden>
                        <p class="sub pic-pending">Preview. Not saved yet.</p>
                        <div class="pic-confirm-actions">
                            <button type="submit" form="picture-upload" class="btn btn-primary btn-sm" data-picture-save>Save</button>
                            <button type="button" class="btn btn-sm" data-picture-cancel>Cancel</button>
                        </div>
                    </div>
                    @if (picture is not null)
                    {
                        <button type="submit" form="picture-remove" class="linkbtn pic-inline" data-picture-remove hidden>Remove picture</button>
                    }
                }
            </div>
        </div>
        @* The result of an upload or removal, under the name card; the script also writes its own checks here. *@
        @if (ResultMessage is { } message)
        {
            <div class="banner @(PictureResult is "saved" or "removed" ? "ok" : "danger")" role="@(PictureResult is "saved" or "removed" ? "status" : "alert")" data-picture-result>
                <Icon Name="@(PictureResult is "saved" or "removed" ? "check" : "alert")" Size="18" />
                <div>@message</div>
            </div>
        }
        <div class="banner danger" role="alert" data-picture-error hidden>
            <Icon Name="alert" Size="18" />
            <div data-picture-error-text></div>
        </div>
        @* F06: the picture panel (prototype picturePanelHTML), used when script is off. Hidden until the pencil's link
           targets it, which the redirect after a post also does; always shown when upload isn't set up. *@
        <section class="picture-card @(Pictures.IsAvailable ? "" : "is-open")" id="picture" aria-labelledby="picture-heading">
            <h2 id="picture-heading">Profile picture</h2>
            @if (Pictures.IsAvailable)
            {
                <form method="post" action="@PictureEndpoints.UploadPath" enctype="multipart/form-data" class="picture-form" id="picture-upload">
                    <AntiforgeryToken />
                    <label for="picture-file" class="font-semibold">@(picture is null ? "Add a picture" : "Choose a new picture")</label>
                    <input id="picture-file" name="picture" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="picture-hint" />
                    <button type="submit" class="btn btn-primary btn-sm">Upload picture</button>
                </form>
                <p id="picture-hint" class="hint">JPEG, PNG or WebP, up to 5 MB. It's cropped to a square, and location and camera details are removed. @(isAccountant ? "Shown on your public profile and in the directory." : "Only you and the accountants you chat with see it.")</p>
                <div class="picture-actions">
                    @if (picture is not null)
                    {
                        <form method="post" action="@PictureEndpoints.RemovePath" id="picture-remove">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-ghost btn-sm"><Icon Name="trash" Size="16" /> Remove picture</button>
                        </form>
                    }
                    <a class="linkbtn" href="/account">Close</a>
                </div>
            }
            else
            {
                <p class="hint">Picture upload isn't set up on this site yet. Your initials are shown instead.</p>
            }
        </section>
        </div>

        @if (!isAccountant && detailsUnavailable)
        {
            <section class="details-card" id="details" aria-labelledby="details-heading">
                <h2 id="details-heading">Your details</h2>
                <p class="muted">Your details can't be shown right now. Please try again later.</p>
            </section>
        }
        else if (!isAccountant && details is not null && EditDetails)
        {
            <section class="details-card is-editing" id="details" aria-labelledby="details-heading">
                <h2 id="details-heading">Edit your details</h2>
                @SharedWithNote
                @if (detailsFailed)
                {
                    <div class="banner danger" role="alert"><Icon Name="alert" Size="18" /><div>We couldn't save your details. Please try again.</div></div>
                }
                <form method="post" @formname="client-details" @onsubmit="SaveDetailsAsync" novalidate class="form">
                    <AntiforgeryToken />
                    <fieldset>
                        <legend>About you</legend>
                        @Field("details-name", ClientDetailsRules.Fields.Name, "Your name", DetailsForm!.Name, required: true, autocomplete: "name",
                            hint: "Shown to the accountants you contact. Reviews show your first name and last initial.")
                        @Field("details-phone", ClientDetailsRules.Fields.Phone, "Phone", DetailsForm.Phone, type: "tel", autocomplete: "tel",
                            placeholder: "+63 900 000 0000", hint: "Leave it blank if you prefer chat.")
                        @Field("details-city", ClientDetailsRules.Fields.City, "City", DetailsForm.City, autocomplete: "address-level2", placeholder: "e.g. Pasig City")
                        <div class="field">
                            <span class="details-label">Email</span>
                            <p class="details-static">@details.Email<span class="hint">From your Google sign-in. Not shown to accountants.</span></p>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Your business</legend>
                        @Field("details-business", ClientDetailsRules.Fields.BusinessName, "Business name", DetailsForm.BusinessName, autocomplete: "organization", placeholder: "e.g. Rivera Trading")
                        <div class="field">
                            <label for="details-type">Type <span class="req">(optional)</span></label>
                            <select id="details-type" name="DetailsForm.BusinessType" aria-invalid="@(Problem(ClientDetailsRules.Fields.BusinessType) is null ? null : "true")"
                                    aria-describedby="@(Problem(ClientDetailsRules.Fields.BusinessType) is null ? null : "details-type-error")">
                                <option value="">Choose a type</option>
                                @foreach (var type in ClientDetailsRules.BusinessTypes)
                                {
                                    <option value="@type" selected="@(DetailsForm.BusinessType == type)">@type</option>
                                }
                            </select>
                            @if (Problem(ClientDetailsRules.Fields.BusinessType) is { } typeProblem)
                            {
                                <span class="ferr" id="details-type-error">@typeProblem</span>
                            }
                        </div>
                        @Field("details-industry", ClientDetailsRules.Fields.Industry, "Industry", DetailsForm.Industry, placeholder: "e.g. Food and drink")
                    </fieldset>
                    <p class="note"><Icon Name="info" Size="18" /><span>Don't add your TIN or other ID numbers here. Give them privately when an accountant asks for them.</span></p>
                    <div class="actions">
                        <button type="submit" class="btn btn-primary">Save details</button>
                        <a class="btn" href="/account#details">Cancel</a>
                    </div>
                </form>
            </section>
        }
        else if (!isAccountant && details is not null)
        {
            <section class="details-card" id="details" aria-labelledby="details-heading">
                <div class="details-head">
                    <h2 id="details-heading">Your details</h2>
                    <a class="btn btn-sm" href="/account?edit=details#details"><Icon Name="edit" Size="16" /> Edit details</a>
                </div>
                <dl>
                    <dt>Phone</dt><dd class="@(details.Details.Phone is null ? "muted" : null)">@(details.Details.Phone ?? "Not added")</dd>
                    <dt>City</dt><dd class="@(details.Details.City is null ? "muted" : null)">@(details.Details.City ?? "Not added")</dd>
                    <dt>Business</dt><dd class="@(details.Details.BusinessLine is null ? "muted" : null)">@(details.Details.BusinessLine ?? "Not added")</dd>
                </dl>
                <p class="muted small">Shared with the accountants you contact. Never shown publicly.</p>
                @if (DetailsResult == "saved")
                {
                    <p class="save-status ok" role="status">Saved. The accountants you contact see these details.</p>
                }
            </section>
        }

        <ul class="menu">
            @* F03 (R19, R20): the workspace, as in the site bar and the phone tabs (DESIGN workspace navigation). *@
            <li>
                <a class="mi" href="/workspace">
                    <Icon Name="list" />
                    <span class="mi-main">@(isAccountant ? "Clients and service work" : "My accountants and service progress")<small>Private checklists, shared updates and service documents</small></span>
                    <Icon Name="chevron" />
                </a>
            </li>
            @if (isAccountant)
            {
                <li>
                    <a class="mi" href="/account/profile">
                        <Icon Name="edit" />
                        <span class="mi-main">My profile and portfolio<small>@ProfileStatusText</small></span>
                        <Icon Name="chevron" />
                    </a>
                </li>
            }
            @if (email is not null)
            {
                @* F14 (R08): prototype emailRow. *@
                <li>
                    <div class="mi">
                        <Icon Name="mail" />
                        <span class="mi-main">Email notifications: @(email.On ? "On" : "Off")<small>@(email.On
                            ? $"We email {email.Address} when {(isAccountant ? "a client messages you" : "an accountant replies to you")} and you're not on the site. Emails don't include the message text."
                            : "You won't get emails. New messages still show as unread in Chats.")</small></span>
                        <form method="post" action="@EmailPreferences.EndpointPath">
                            <AntiforgeryToken />
                            <input type="hidden" name="on" value="@(email.On ? "false" : "true")" />
                            <input type="hidden" name="returnUrl" value="/account" />
                            <button type="submit" class="btn btn-sm">@(email.On ? "Turn off" : "Turn on")</button>
                        </form>
                    </div>
                </li>
            }
            <li>
                <form method="post" action="@AccountEndpoints.SignOutPath">
                    <AntiforgeryToken />
                    <button type="submit" class="mi"><Icon Name="logout" /><span class="mi-main">Sign out</span></button>
                </form>
            </li>
        </ul>
        @* F12 (R09): prototype meHTML's separate danger menu. *@
        <ul class="menu">
            <li>
                <a class="mi danger" href="/account/delete">
                    <Icon Name="trash" />
                    <span class="mi-main">Delete account</span>
                    <Icon Name="chevron" />
                </a>
            </li>
        </ul>
    }

    <nav class="infolinks" aria-label="About Tax Buddy">
        <a href="/about">About</a>
        <a href="/help">Help</a>
        <a href="/for-accountants">For accountants</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
    </nav>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    /// <summary>F17: "details" opens the client's details form in the card.</summary>
    [SupplyParameterFromQuery(Name = "edit")] public string? Edit { get; set; }

    /// <summary>F17: "saved" after the details were saved (the redirect after the post).</summary>
    [SupplyParameterFromQuery(Name = "details")] public string? DetailsResult { get; set; }

    [SupplyParameterFromForm(FormName = "client-details")] private ClientDetailsInput? DetailsForm { get; set; }

    private ClientDetailsView? details;
    private bool detailsUnavailable;
    private bool detailsFailed;
    private IReadOnlyDictionary<string, string> problems = ClientDetailsResult.NoProblems;

    private bool EditDetails => Edit == "details";

    private string? Problem(string field) => problems.GetValueOrDefault(field);

    /// <summary>
    /// One text field of the details form: label, input, hint and the field's message, as the profile editor draws them.
    /// </summary>
    private RenderFragment Field(string id, string field, string label, string? value, bool required = false, string type = "text",
        string? autocomplete = null, string? placeholder = null, string? hint = null) => __builder =>
    {
        var problem = Problem(field);
        var describedBy = problem is not null ? id + "-error" : hint is not null ? id + "-hint" : null;
        <div class="field">
            <label for="@id">
                @label
                @if (!required)
                {
                    <span class="req"> (optional)</span>
                }
            </label>
            <input id="@id" name="@("DetailsForm." + field)" type="@type" value="@value" autocomplete="@autocomplete" placeholder="@placeholder"
                   aria-invalid="@(problem is null ? null : "true")" aria-describedby="@describedBy" />
            @if (hint is not null)
            {
                <span class="hint" id="@(id + "-hint")">@hint</span>
            }
            @if (problem is not null)
            {
                <span class="ferr" id="@(id + "-error")">@problem</span>
            }
        </div>
    };

    /// <summary>Who can see the details: the accountants the client has a service with (F17 spec).</summary>
    private RenderFragment SharedWithNote => __builder =>
    {
        var names = details!.SharedWith;
        <p class="details-share">
            <Icon Name="lock" Size="16" />
            <span>
                @if (names.Count == 0)
                {
                    @("Shared with the accountants you contact, once you request a service. Never shown publicly.")
                }
                else
                {
                    @("Shared with the accountants you contact: ")
                    @for (var i = 0; i < names.Count; i++)
                    {
                        @(i > 0 ? ", " : null)<strong>@names[i]</strong>
                    }
                    @(". Never shown publicly.")
                }
            </span>
        </p>
    };

    private async Task SaveDetailsAsync()
    {
        var result = await ClientDetailsData.SaveAsync(HttpContext!.User, DetailsForm!);
        switch (result.Outcome)
        {
            case ClientDetailsOutcome.Saved:
                Navigation.NavigateTo("/account?details=saved#details");
                break;
            case ClientDetailsOutcome.Invalid:
                problems = result.Problems;
                break;
            case ClientDetailsOutcome.Failed:
                detailsFailed = true;
                break;
            default:
                Navigation.NavigateTo("/account");
                break;
        }
    }

    /// <summary>The outcome of a picture upload or removal (F06), from the redirect after the post.</summary>
    [SupplyParameterFromQuery(Name = "picture")] public string? PictureResult { get; set; }

    private string? picture;

    private string? ResultMessage => PictureResult switch
    {
        "saved" => "Picture updated.",
        "removed" => "Picture removed. Your initials are shown instead.",
        "no-file" => "Choose a photo first.",
        "too-large" => "That file is over 5 MB. Choose a smaller photo.",
        "too-many-pixels" => "That photo has too many pixels to process. Choose a smaller one.",
        "not-an-image" => "That file isn't a JPEG, PNG or WebP photo.",
        "unavailable" => "Picture upload isn't set up on this site yet.",
        "failed" => "We couldn't save your picture. Your current picture is unchanged; please try again.",
        _ => null,
    };

    private ClaimsPrincipal? user;
    private string name = "";
    private string provider = "";
    private bool isAccountant;
    private ListingStatus? status;
    private bool statusUnavailable;
    private EmailSetting? email;

    private string ProfileStatusText => statusUnavailable ? "Status unavailable right now"
        : status?.IsListed == true ? "Listed in the directory" : "Not listed yet";

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        user = HttpContext.User;
        name = user.FindFirst(TaxBuddyClaimsFactory.DisplayNameClaim)?.Value ?? "Tax Buddy user";
        provider = user.FindFirst(ClaimTypes.AuthenticationMethod)?.Value ?? "Google";
        picture = user.FindFirst(TaxBuddyClaimsFactory.PictureClaim)?.Value;
        isAccountant = user.FindFirst(ClaimTypes.Role)?.Value == AccountRoles.ValueOf(AccountRole.Accountant);
        if (EmailPreferences.SignedInAccount(user) is { } accountId)
        {
            try
            {
                email = await EmailSettings.GetAsync(accountId);
            }
            catch (Exception ex) when (ex is System.Data.Common.DbException or TimeoutException or InvalidOperationException)
            {
                email = null; // The row is left out when the database is down; the rest of Account still works.
            }
        }
        if (!isAccountant)
        {
            try
            {
                details = await ClientDetailsData.LoadAsync(user);
            }
            catch (Exception ex) when (ex is System.Data.Common.DbException or TimeoutException or InvalidOperationException)
            {
                detailsUnavailable = true; // The card says so; the rest of Account still works.
            }

            // The form starts from what is saved; after a refused post it keeps what was typed (BR18).
            DetailsForm ??= details is null ? null : new ClientDetailsInput
            {
                Name = details.Name,
                Phone = details.Details.Phone,
                City = details.Details.City,
                BusinessName = details.Details.BusinessName,
                BusinessType = details.Details.BusinessType,
                Industry = details.Details.Industry,
            };
        }

        if (isAccountant && Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var owner))
        {
            try
            {
                (_, status) = await Editor.LoadAsync(owner, name);
            }
            catch (TaxBuddy.Web.Application.Directory.DataUnavailableException)
            {
                statusUnavailable = true;
            }
        }
    }
}
