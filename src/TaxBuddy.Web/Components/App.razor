@* Pages are static unless the SDD render-mode table says otherwise: no app-wide render mode on Routes or HeadOutlet (ADR 010). *@
@inject IConfiguration Configuration
<!DOCTYPE html>
@* data-theme is absent for System, so the stylesheet follows the browser setting (F02 BD09). *@
<html lang="en" data-theme="@ThemeAttribute">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    @if (!Configuration.GetValue<bool>("Seo:AllowIndexing"))
    {
        @* SDD search engines: no indexing until PRD D19 is decided, and never on the test site. *@
        <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="icon" type="image/svg+xml" href="@Assets["images/favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TaxBuddy.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    // Blazor leaves out an attribute whose value is null.
    private string? ThemeAttribute => ThemePreference.Read(HttpContext) switch
    {
        Theme.System => null,
        var theme => ThemePreference.ValueOf(theme),
    };
}
