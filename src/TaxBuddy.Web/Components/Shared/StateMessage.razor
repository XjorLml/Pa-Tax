@* Empty, no-match, unavailable and error states (DESIGN: screen and component states), as the prototype's stateHTML: a
   plain centred block with the icon in a circle. A page whose only content is the state gives it the page's h1
   (HeadingLevel 1); it is drawn the same as the prototype's h2. *@
<div class="state">
    <Icon Name="@IconName" Size="36" Class="ic" />
    @if (HeadingLevel == 1)
    {
        <h1 tabindex="-1">@Title</h1>
    }
    else
    {
        <h2>@Title</h2>
    }
    @if (Text is not null)
    {
        <p>@Text</p>
    }
    else if (Description is not null)
    {
        <p>@Description</p>
    }
    @if (ChildContent is not null)
    {
        <div class="state-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string IconName { get; set; } = "alert";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Text { get; set; }

    /// <summary>The text with markup, such as the error page's bold support code; used when <see cref="Text"/> is null.</summary>
    [Parameter] public RenderFragment? Description { get; set; }

    [Parameter] public int HeadingLevel { get; set; } = 2;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
