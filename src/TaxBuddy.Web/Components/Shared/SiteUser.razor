@using TaxBuddy.Web.Account
@* Site bar user area (prototype desktopShell): the avatar and name link to Account, or "For accountants" and "Sign in",
   then the theme toggle (BD14). *@
<div class="siteuser">
    <AuthorizeView>
        <Authorized>
            @{ var name = context.User.FindFirst(TaxBuddyClaimsFactory.DisplayNameClaim)?.Value ?? "Account"; }
            <NavLink class="userlink" href="/account">
                <Avatar Name="@name" Picture="@(context.User.FindFirst(TaxBuddyClaimsFactory.PictureClaim)?.Value)" Size="sm" />
                <span>@name</span>
            </NavLink>
        </Authorized>
        <NotAuthorized>
            @* F13 (R17): prototype desktopShell's "For accountants" for visitors, hidden on narrow desktops. *@
            <a class="btn btn-ghost btn-sm siteuser-foracc" href="/for-accountants">For accountants</a>
            <a class="btn btn-primary btn-sm" href="@AccountEndpoints.SignInLinkFor(HttpContext)">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
    <ThemeToggle />
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
}
