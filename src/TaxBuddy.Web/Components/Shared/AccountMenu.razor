@using TaxBuddy.Web.Account
@using TaxBuddy.Web.Domain
@* F04 header: "Sign in", or the signed-in name with "Sign out" (GS01, GS06). A link and a plain form: no script. *@
<AuthorizeView>
    <Authorized>
        <div class="account-menu">
            <span class="account-name">
                @(context.User.FindFirst(TaxBuddyClaimsFactory.DisplayNameClaim)?.Value)
                <span class="text-muted">· @RoleLabel(context.User)</span>
            </span>
            <form method="post" action="@AccountEndpoints.SignOutPath">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-small">Sign out</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-small account-menu" href="@AccountEndpoints.SignInPageAddress(SignInReturnAddress())">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user) =>
        AccountRoles.Parse(user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value) is { } role ? AccountRoles.Label(role) : "";

    /// <summary>Back to this page after sign-in, except from the sign-in pages themselves.</summary>
    private string SignInReturnAddress()
    {
        var current = LocalAddress.CurrentFor(HttpContext);
        return current.StartsWith("/signin", StringComparison.Ordinal) || current.StartsWith(AccountEndpoints.RegisterPath, StringComparison.Ordinal)
            ? "/"
            : current;
    }
}
