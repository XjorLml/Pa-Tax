@using TaxBuddy.Web.Account
@inject AccountService Accounts
@* The prototype's howHTML steps. Sign-in names the providers this site offers (F15). The For accountants line joined
   on 2026-11-24, since that page (R17, F13) exists. *@
<ol class="steps @(Row ? "row" : null)">
    <li><strong>Browse for free</strong><span>Read portfolios and reviews without an account.</span></li>
    <li><strong>Message who you like</strong><span>Sign in with @providers first.</span></li>
    <li><strong>Rate how it went</strong><span>Once they have replied to you, you can leave a review.</span></li>
</ol>
<p class="hero-foot">Are you an accountant? <a href="/for-accountants">See how listing works</a></p>

@code {
    [Parameter] public bool Row { get; set; }

    private string providers = "Google";

    protected override async Task OnInitializedAsync() => providers = await Accounts.ProviderNamesAsync();
}
