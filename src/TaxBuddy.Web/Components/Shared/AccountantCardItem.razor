@* A directory card (PRD R01; prototype cardHTML, F02 BD10). The heading link covers the whole card, so there is one link
   per card. The prototype's rating line and highlight count join with R13 and R12. *@
<li>
    <article class="card">
        <div class="card-top">
            <span class="avatar @Display.Tone(Card.Name)" aria-hidden="true">@Display.Initials(Card.Name)</span>
            <div class="min-w-0 flex-1">
                <h3>
                    <a href="@Display.ProfilePath(Card.Id)" class="text-text no-underline after:absolute after:inset-0 after:rounded-xl after:content-['']">@Card.Name</a>
                </h3>
                <p class="sub">@Card.Title</p>
            </div>
        </div>
        <p class="facts">
            @if (Card.City is not null)
            {
                <span><Icon Name="pin" Size="14" />@Card.City</span>
            }
            @if (Card.YearsOfExperience is { } years)
            {
                <span>@Display.YearsOfExperience(years)</span>
            }
        </p>
        <ul class="tags" aria-label="Services">
            @foreach (var service in Card.Services)
            {
                <li class="tag">@service</li>
            }
        </ul>
        <p class="clamp-2">@Card.Summary</p>
        <span class="card-foot" aria-hidden="true"><span class="card-link">View profile <Icon Name="chevron" Size="16" /></span></span>
    </article>
</li>

@code {
    [Parameter, EditorRequired] public AccountantCard Card { get; set; } = default!;
}
